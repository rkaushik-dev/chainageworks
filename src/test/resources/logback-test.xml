<?xml version="1.0" encoding="UTF-8"?>
<!-- The suite prints warnings and worse, and nothing else. -->
<configuration>
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} %msg%n</pattern>
        </encoder>
    </appender>
    <!-- A request for a path no route serves is answered with a 404; it is not a warning about the server. -->
    <logger name="org.springframework.web.servlet.PageNotFound" level="ERROR"/>
    <root level="WARN">
        <appender-ref ref="console"/>
    </root>
</configuration>
